{
  "name": "testronaut-examples",
  "version": "1.0.0",
  "description": "a set of example missions for testing demo.testronaut.app",
  "main": "index.js",
  "scripts": {
    "test": "testronaut",
    "suite:isolated": "testronaut addTask.mission.js startTask.mission.js completeAllTasks.mission.js removeTask.mission.js",
    "suite:shared-auth": "testronaut --session=shared-auth addTask.mission.js startTask.mission.js completeAllTasks.mission.js removeTask.mission.js",
    "benchmark:agent-modes": "node scripts/benchmark-agent-modes.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mission-testronaut/testronaut-examples.git"
  },
  "keywords": [
    "testing",
    "ai",
    "automation"
  ],
  "author": "Shane Fast",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mission-testronaut/testronaut-examples/issues"
  },
  "homepage": "https://github.com/mission-testronaut/testronaut-examples#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  },
  "dependencies": {
    "testronaut": "^1.9.3"
  }
}
