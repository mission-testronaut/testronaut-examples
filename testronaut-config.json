{
  "provider": "openai",
  "model": "gpt-5.6-terra",
  "initialized": true,
  "outputDir": "missions/mission_reports",
  "projectName": "testronaut-examples",
  "maxTurns": 20,
  "tags": [],
  "tagMatch": "any",
  "addTags": [],
  "dom": {
    "listItemLimit": 3,
    "automaticLimit": 15000
  },
  "resourceGuard": {
    "enabled": true,
    "hrefIncludes": [
      "/document/",
      "/file/",
      "/download",
      "/attachment/"
    ],
    "dataTypes": [
      "document",
      "file",
      "item",
      "row"
    ]
  },
  "humanInput": {
    "enabled": true,
    "timeoutSeconds": 60
  },
  "guardrails": {
    "enabled": false,
    "mode": "live",
    "completionProbability": 0.8
  },
  "rateLimits": {
    "tier": "unknown",
    "region": "global",
    "safetyMargin": 0.9,
    "models": {
      "gpt-5.6-terra": {
        "fallbackTPM": 500000
      }
    }
  }
}
