{
  "provider": "anthropic",
  "model": "claude-sonnet-5",
  "initialized": true,
  "outputDir": "missions/mission_reports",
  "projectName": "testronaut-examples",
  "maxTurns": 20,
  "tags": [],
  "tagMatch": "any",
  "addTags": [],
  "dom": {
    "listItemLimit": 3
  },
  "resourceGuard": {
    "enabled": true,
    "hrefIncludes": [
      "/document/",
      "/file/",
      "/download",
      "/attachment/"
    ],
    "dataTypes": [
      "document",
      "file",
      "item",
      "row"
    ]
  },
  "humanInput": {
    "enabled": true,
    "timeoutSeconds": 60
  }
}